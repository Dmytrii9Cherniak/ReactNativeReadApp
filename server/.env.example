PORT=3000
DATABASE_URL=postgres://reader:reader@localhost:5433/reader
# Origins web-версії застосунку, через кому (Expo web — 8081)
CORS_ORIGINS=http://localhost:8081

# Секрети: для кожного — окреме значення з `npm run secret`
JWT_ACCESS_SECRET=
CODE_HMAC_SECRET=

# Пошта (за замовчуванням — Mailpit з docker-compose, листи видно на http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=ReadApp <no-reply@readapp.local>

# Файли книг: папка на диску сервера і максимальний розмір одного файлу
STORAGE_DIR=storage
MAX_BOOK_SIZE_MB=50
